{
  "__inputs": [
    {
      "name": "DS_CHRISTMAS",
      "label": "Christmas Stats (TimescaleDB)",
      "type": "datasource",
      "pluginId": "grafana-postgresql-datasource",
      "pluginName": "PostgreSQL"
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true,
  "panels": [
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_CHRISTMAS}"
      },
      "type": "stat",
      "title": "Totals",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_CHRISTMAS}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (SELECT COUNT(*) FROM song_vote WHERE $__timeFilter(ts)) AS \"Song votes\",\n       (SELECT COUNT(DISTINCT source) FROM song_vote WHERE $__timeFilter(ts)) AS \"Song voters\",\n       (SELECT COUNT(*) FROM snowman_vote WHERE $__timeFilter(ts)) AS \"Snowman votes\",\n       (SELECT COUNT(DISTINCT source) FROM snowman_vote WHERE $__timeFilter(ts)) AS \"Snowman voters\"",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto"
      },
      "id": 1
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_CHRISTMAS}"
      },
      "type": "barchart",
      "title": "Song votes",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 16
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_CHRISTMAS}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT playlist AS \"Song\", COUNT(*) AS \"Votes\", COUNT(DISTINCT source) AS \"Voters\"\nFROM song_vote\nWHERE $__timeFilter(ts)\nGROUP BY 1\nORDER BY 2 DESC, 1",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "xTickLabelMaxLength": 24,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "id": 2
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_CHRISTMAS}"
      },
      "type": "table",
      "title": "Votes vs. plays",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 16
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_CHRISTMAS}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH v AS (\n  SELECT playlist AS song, COUNT(*) AS votes, COUNT(DISTINCT source) AS voters\n  FROM song_vote WHERE $__timeFilter(ts) GROUP BY 1\n), p AS (\n  SELECT argument AS song, COUNT(*) AS plays\n  FROM event\n  WHERE name = 'planSong' AND $__timeFilter(ts) AND argument NOT LIKE 'Internal%'\n  GROUP BY 1\n)\nSELECT COALESCE(v.song, p.song) AS \"Song\", COALESCE(v.votes, 0) AS \"Votes\",\n       COALESCE(v.voters, 0) AS \"Voters\", COALESCE(p.plays, 0) AS \"Plays\"\nFROM v FULL JOIN p ON v.song = p.song\nORDER BY 2 DESC, 4 DESC, 1",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "Songs with no votes still listed so you can see what nobody picks.",
      "id": 3
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_CHRISTMAS}"
      },
      "type": "barchart",
      "title": "Snowman votes",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 12
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_CHRISTMAS}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT snowman AS \"Snowman\", COUNT(*) AS \"Votes\", COUNT(DISTINCT source) AS \"Voters\"\nFROM snowman_vote\nWHERE $__timeFilter(ts)\nGROUP BY 1\nORDER BY 2 DESC, 1",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "xTickLabelMaxLength": 24,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "id": 4
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_CHRISTMAS}"
      },
      "type": "timeseries",
      "title": "Votes per hour",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_CHRISTMAS}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, '1h'), COUNT(*) AS \"Song votes\"\nFROM song_vote\nWHERE $__timeFilter(ts)\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_CHRISTMAS}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, '1h'), COUNT(*) AS \"Snowman votes\"\nFROM snowman_vote\nWHERE $__timeFilter(ts)\nGROUP BY 1\nORDER BY 1",
          "refId": "B"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "id": 5
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "christmas"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Song & Snowman Votes",
  "uid": "xmas-votes"
}
