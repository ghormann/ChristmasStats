{
  "__inputs": [
    {
      "name": "DS_CHRISTMAS",
      "label": "Christmas Stats (TimescaleDB)",
      "type": "datasource",
      "pluginId": "grafana-postgresql-datasource",
      "pluginName": "PostgreSQL"
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true,
  "panels": [
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_CHRISTMAS}"
      },
      "type": "timeseries",
      "title": "Uptime",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_CHRISTMAS}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, $__interval), device AS metric, MAX(value) AS value\nFROM sensor\nWHERE $__timeFilter(ts) AND sensor = 'fpp uptime'\nGROUP BY 1, 2\nORDER BY 1",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "description": "Drops to zero mark reboots.",
      "id": 1
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_CHRISTMAS}"
      },
      "type": "table",
      "title": "Latest uptime per controller",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Uptime (days)"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_CHRISTMAS}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT DISTINCT ON (device) device AS \"Controller\", value AS \"Uptime (days)\", ts AS \"Reported\"\nFROM sensor\nWHERE $__timeFilter(ts) AND sensor = 'fpp uptime'\nORDER BY device, ts DESC",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 2
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "christmas"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timezone": "browser",
  "title": "FPP Uptime",
  "uid": "afkwgq04dzb40d"
}
