{
  "__inputs": [
    {
      "name": "DS_CHRISTMAS",
      "label": "Christmas Stats (TimescaleDB)",
      "type": "datasource",
      "pluginId": "grafana-postgresql-datasource",
      "pluginName": "PostgreSQL"
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true,
  "panels": [
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_CHRISTMAS}"
      },
      "type": "timeseries",
      "title": "Amps by port",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "amp",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_CHRISTMAS}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, $__interval), AVG(s1) AS \"Port 1\", AVG(s2) AS \"Port 2\", AVG(s3) AS \"Port 3\", AVG(s4) AS \"Port 4\", AVG(s5) AS \"Port 5\", AVG(s6) AS \"Port 6\", AVG(s7) AS \"Port 7\", AVG(s8) AS \"Port 8\", AVG(s9) AS \"Port 9\"\nFROM power\nWHERE $__timeFilter(ts)\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "id": 1
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_CHRISTMAS}"
      },
      "type": "bargauge",
      "title": "Average amps by port",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 2,
          "unit": "amp"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_CHRISTMAS}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT AVG(s1) AS \"Port 1\", AVG(s2) AS \"Port 2\", AVG(s3) AS \"Port 3\", AVG(s4) AS \"Port 4\", AVG(s5) AS \"Port 5\", AVG(s6) AS \"Port 6\", AVG(s7) AS \"Port 7\", AVG(s8) AS \"Port 8\", AVG(s9) AS \"Port 9\"\nFROM power\nWHERE $__timeFilter(ts)",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "vertical",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 2
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "christmas"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Power by Port",
  "uid": "efkwissjqxurkb"
}
