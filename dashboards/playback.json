{
  "__inputs": [
    {
      "name": "DS_CHRISTMAS",
      "label": "Christmas Stats (TimescaleDB)",
      "type": "datasource",
      "pluginId": "grafana-postgresql-datasource",
      "pluginName": "PostgreSQL"
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true,
  "panels": [
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_CHRISTMAS}"
      },
      "type": "stat",
      "title": "Summary",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Show running"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_CHRISTMAS}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH e AS (\n  SELECT ts, argument,\n         LEAST(LEAD(ts) OVER (ORDER BY ts), NOW()) - ts AS dur\n  FROM event\n  WHERE name = 'planSong' AND $__timeFilter(ts)\n)\nSELECT COUNT(*) FILTER (WHERE argument NOT LIKE 'Internal%') AS \"Songs played\",\n       EXTRACT(EPOCH FROM SUM(dur) FILTER (WHERE argument <> 'Internal_off')) AS \"Show running\",\n       COUNT(*) FILTER (WHERE argument = 'Internal_Wish_Name') AS \"Name segments\",\n       COUNT(*) FILTER (WHERE argument = 'Internal_Donate') AS \"Donate segments\",\n       COUNT(*) FILTER (WHERE argument = 'Internal_TuneTo') AS \"Tune-to segments\"\nFROM e",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto"
      },
      "id": 1
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_CHRISTMAS}"
      },
      "type": "state-timeline",
      "title": "What's playing",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_CHRISTMAS}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, CASE WHEN argument LIKE 'Internal%' THEN replace(argument, 'Internal_', '') ELSE 'Song' END AS \"Segment\", replace(argument, 'Internal_', '') AS \"Playlist\"\nFROM event\nWHERE name = 'planSong' AND $__timeFilter(ts)\nORDER BY 1",
          "refId": "A"
        }
      ],
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "rowHeight": 0.85,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 2
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_CHRISTMAS}"
      },
      "type": "barchart",
      "title": "Plays per song",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 16
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_CHRISTMAS}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT argument AS \"Song\", COUNT(*) AS \"Plays\"\nFROM event\nWHERE name = 'planSong' AND $__timeFilter(ts) AND argument NOT LIKE 'Internal%'\nGROUP BY 1\nORDER BY 2 DESC, 1",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "xTickLabelMaxLength": 24,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "id": 3
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_CHRISTMAS}"
      },
      "type": "piechart",
      "title": "Time by segment",
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_CHRISTMAS}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH e AS (\n  SELECT ts, argument,\n         LEAST(LEAD(ts) OVER (ORDER BY ts), NOW()) - ts AS dur\n  FROM event\n  WHERE name = 'planSong' AND $__timeFilter(ts)\n)\nSELECT CASE WHEN argument LIKE 'Internal%' THEN replace(argument, 'Internal_', '') ELSE 'Song' END AS \"Segment\", EXTRACT(EPOCH FROM SUM(dur)) AS \"Time\"\nFROM e\nGROUP BY 1\nORDER BY 2 DESC",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [],
          "fields": "",
          "values": true
        },
        "pieType": "donut",
        "displayLabels": [
          "percent"
        ],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "value"
          ]
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "id": 4
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_CHRISTMAS}"
      },
      "type": "timeseries",
      "title": "Songs and segments per hour",
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_CHRISTMAS}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, '1h'),\n       COUNT(*) FILTER (WHERE argument NOT LIKE 'Internal%') AS \"Songs\",\n       COUNT(*) FILTER (WHERE argument = 'Internal_Wish_Name') AS \"Names\",\n       COUNT(*) FILTER (WHERE argument = 'Internal_Donate') AS \"Donate\",\n       COUNT(*) FILTER (WHERE argument = 'Internal_TuneTo') AS \"Tune-to\",\n       COUNT(*) FILTER (WHERE argument = 'Internal_Driveway') AS \"Driveway\"\nFROM event\nWHERE name = 'planSong' AND $__timeFilter(ts)\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "id": 5
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "christmas"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Show Playback",
  "uid": "xmas-playback"
}
